# Copy to .env.local for local runs; set the same names in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# The "Melsoft Content" Drive folder: its ID or its full link. The folder
# must be shared "Anyone with the link — Viewer".
DRIVE_FOLDER_ID=

# The Gmail / Google Workspace account that sends sign-in links, and an
# app password for it (Google Account → Security → App passwords).
SMTP_USER=
SMTP_PASS=

# Signs sign-in links and session cookies. Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional (one is derived from SMTP_PASS if unset). Changing it signs
# everyone out.
CONTENT_LIBRARY_SECRET=

# Optional: the address sign-in links point at, e.g. https://content.example.com
# Defaults to the domain the request came in on.
SITE_URL=
